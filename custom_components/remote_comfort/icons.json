{
  "entity": {
    "sensor": {
      "status": {
        "default": "mdi:home-thermometer",
        "state": {
          "home": "mdi:home",
          "working": "mdi:laptop",
          "away": "mdi:home-export-outline",
          "returning": "mdi:home-import-outline",
          "sleep": "mdi:sleep",
          "vacation": "mdi:airplane",
          "paused": "mdi:pause-circle-outline"
        }
      },
      "cool_target": { "default": "mdi:snowflake-thermometer" },
      "heat_target": { "default": "mdi:sun-thermometer" },
      "zone_comfort": { "default": "mdi:home-floor-1" },
      "room_temperature": { "default": "mdi:thermometer" }
    },
    "binary_sensor": {
      "balancing": { "default": "mdi:air-filter", "state": { "on": "mdi:hvac", "off": "mdi:hvac-off" } }
    },
    "select": {
      "mode": { "default": "mdi:home-switch-outline" },
      "today": { "default": "mdi:calendar-today" }
    },
    "switch": {
      "control": { "default": "mdi:thermostat-auto" }
    },
    "number": {
      "comfort_cool": { "default": "mdi:snowflake" },
      "comfort_heat": { "default": "mdi:fire" },
      "sleep_cool": { "default": "mdi:weather-night" },
      "sleep_heat": { "default": "mdi:weather-night" },
      "away_cool": { "default": "mdi:home-export-outline" },
      "away_heat": { "default": "mdi:home-export-outline" }
    }
  }
}
